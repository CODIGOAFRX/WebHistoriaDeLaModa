# Acceso temporal a /admin. Los valores por defecto también son admin/admin.
# No uses estas credenciales en una publicación real.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Sustituye este valor por una cadena larga y aleatoria antes de publicar.
# Si se omite, la firma se deriva de las credenciales temporales.
ADMIN_SESSION_SECRET=cambia-este-secreto-antes-de-publicar
