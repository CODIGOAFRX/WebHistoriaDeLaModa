{
  "name": "historia-de-la-moda",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/sanitize-cloudflare-build.mjs",
    "start": "vinext start",
    "test": "npm run build && npm run test:unit && node --test tests/browser-responsive.test.mjs && npm run test:admin-ui",
    "test:unit": "npm run test:auth && npm run test:contact && node --experimental-strip-types --test tests/media-upload.test.mjs && node --test tests/rendered-html.test.mjs tests/content-contract.test.mjs",
    "test:browser": "npm run build && node --test tests/browser-responsive.test.mjs",
    "test:auth": "node --experimental-strip-types --test tests/admin-auth.test.mjs",
    "test:contact": "node --experimental-strip-types --test tests/contact-form.test.mjs",
    "test:admin-ui": "node --test tests/admin-crud-browser.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "check:cloudflare": "npm run check:cloudflare:config && npm run check:cloudflare:artifact",
    "check:cloudflare:artifact": "npm run build && node scripts/check-cloudflare-readiness.mjs",
    "check:cloudflare:config": "node scripts/validate-cloudflare-config.mjs",
    "check:cloudflare:secrets": "node scripts/validate-cloudflare-secrets.mjs",
    "preview:cloudflare": "npm run check:cloudflare:artifact && vite preview --host 127.0.0.1 --port 30000",
    "deploy:cloudflare:first": "npm run check:cloudflare:secrets && npm run check:cloudflare && wrangler deploy --config dist/server/wrangler.json --secrets-file .env.production",
    "deploy:cloudflare": "npm run check:cloudflare && vinext-cloudflare deploy --skip-build --config dist/server/wrangler.json"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "1.0.0-beta.2",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "axe-core": "^4.13.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "playwright-core": "^1.62.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
