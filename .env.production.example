# Copia este archivo como .env.production y sustituye todos los valores.
# .env.production está ignorado por Git y no debe subirse al repositorio.
ADMIN_USERNAME=elige-un-usuario-no-predecible
ADMIN_PASSWORD=elige-una-contrasena-larga-y-unica
ADMIN_SESSION_SECRET=genera-una-cadena-aleatoria-de-al-menos-48-bytes
